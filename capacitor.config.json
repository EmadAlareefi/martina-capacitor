{
  "appId": "sa.martina",
  "appName": "Martina",
  "webDir": "www",
  "server": {
    "url": "https://martina.sa",
    "cleartext": false,
    "allowNavigation": [
      "martina.sa",
      "*.martina.sa",
      "sa.myfatoorah.com",
      "*.myfatoorah.com",
      "*.tabby.ai",
      "*.tamara.co"
    ]
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "SplashScreen": {
      "launchShowDuration": 1000,
      "backgroundColor": "#fff9f6",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#fff9f6"
    }
  }
}
